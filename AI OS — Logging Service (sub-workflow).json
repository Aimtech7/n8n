    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nreturn [{ json: {\n  workflow: j.workflow || 'unknown',\n  module: j.module || 'unknown',\n  action: j.action || 'unknown',\n  status: j.status || 'unknown',\n  execution_time: (j.execution_time === undefined || j.execution_time === null || j.execution_time === '') ? 0 : j.execution_time,\n  error: j.error || '',\n  execution_id: j.execution_id || ''\n} }];"
      },
      "id": "058db477-af66-4fef-9b25-182f7bb34867",
      "name": "Normalize Log Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
