    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst ok = rows.some(r => r.json && (r.json.success === true || r.json.error === undefined));\nreturn [{ json: { logged: rows.length > 0, module: $('Normalize Log Fields').first().json.module } }];"
      },
