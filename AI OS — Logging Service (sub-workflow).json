        "postgres": {
          "id": "pWWYe9VpyIDwRFN0",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ai_os_executions (id, workflow, status, finished, error) SELECT $1, $2, $3, now(), $4 WHERE $1 <> '' ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status, finished = EXCLUDED.finished, error = EXCLUDED.error",
        "options": {
          "queryReplacement": "={{ $('Normalize Log Fields').item.json.execution_id }},{{ $('Normalize Log Fields').item.json.workflow }},{{ $('Normalize Log Fields').item.json.status }},{{ $('Normalize Log Fields').item.json.error }}"
        }
      },
      "id": "7be2ee35-2f9b-4c17-8e8b-e5bd6ff48af9",
      "name": "Upsert Execution History",
