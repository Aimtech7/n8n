        224,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ai_os_logs (workflow, module, action, status, execution_time, error) VALUES ($1, $2, $3, $4, $5, $6)",
        "options": {
          "queryReplacement": "={{ $json.workflow }},{{ $json.module }},{{ $json.action }},{{ $json.status }},{{ $json.execution_time }},{{ $json.error }}"
        }
      },
      "id": "0cd1b3dc-3c39-484e-a3d8-b6c9166c29fa",
