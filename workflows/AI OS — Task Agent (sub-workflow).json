    {
      "parameters": {
        "jsCode": "const o = ($input.first().json.output) || {};\nconst rand = Math.random().toString(36).slice(2, 8);\nconst task_id = o.task_id && o.task_id.length ? o.task_id : ('T-' + Date.now().toString(36) + '-' + rand);\nreturn [{ json: {\n  intent: (o.intent || '').toLowerCase(),\n  task_id,\n  title: o.title || '',\n  description: o.description || '',\n  priority: o.priority || 'medium',\n  status: o.status || '',\n  owner: o.owner || '',\n  deadline: o.deadline || ''\n} }];"
