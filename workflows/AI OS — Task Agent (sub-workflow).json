    {
      "parameters": {
        "jsCode": "const intent = $('Prep Fields').first().json.intent;\nconst rows = $('Collect').all().map(i => i.json).filter(Boolean);\nlet reply;\nif (rows.length && rows[0].error) reply = 'Task operation failed: ' + rows[0].error;\nelse if (intent === 'create') reply = 'Created task ' + (rows[0] ? rows[0].task_id : '') + '.';\nelse if (intent === 'list') reply = 'Found ' + rows.length + ' task(s).';\nelse if (intent === 'complete') reply = 'Marked task complete.';\nelse if (intent === 'update') reply = 'Task updated.';\nelse reply = 'Done.';\nreturn [{ json: { ok: !(rows.length && rows[0].error), intent, reply, tasks: rows } }];"
      },
      "id": "10242539-b8e4-4b15-832c-d8fb044636a5",
