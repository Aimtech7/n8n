    {
      "parameters": {
        "jsCode": "const op = $('Normalize Input').first().json.operation;\nconst rows = $input.all().map(i => i.json).filter(Boolean);\n// store returns a single id row; recall/search return arrays; unknown returns {ok:false,error}\nif (rows.length === 1 && rows[0].error) {\n  return [{ json: { ok: false, operation: op, error: rows[0].error } }];\n}\nif (op === 'store') {\n  return [{ json: { ok: true, operation: 'store', id: rows[0] ? rows[0].id : null } }];\n}\nreturn [{ json: { ok: true, operation: op, count: rows.length, results: rows } }];"
      },
