# =============================================================
# n8n Environment Variables — Copy to .env and fill in values
# =============================================================

# ── General ──────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
GENERIC_TIMEZONE=Africa/Nairobi

# Public URL used for webhooks (must be externally reachable)
WEBHOOK_URL=http://localhost:5678/

# Secret key used to encrypt stored credentials (keep safe, don't change after first run)
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# ── Database (default: SQLite) ────────────────────────────────
# Uncomment below to use PostgreSQL (recommended for production)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=change-me-strong-password
# DB_POSTGRESDB_SCHEMA=public

# ── Authentication ────────────────────────────────────────────
# Enable basic auth to protect the UI (useful before setting up user accounts)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ── Security ──────────────────────────────────────────────────
# Restrict which hosts can connect (comma-separated)
# N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# N8N_RUNNERS_DISABLED=false

# ── Email / SMTP (for user invites and notifications) ─────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password
N8N_SMTP_SENDER=your-email@gmail.com
N8N_SMTP_SSL=true

# ── Logging ───────────────────────────────────────────────────
N8N_LOG_LEVEL=info
# N8N_LOG_OUTPUT=console,file
# N8N_LOG_FILE_LOCATION=/home/node/.n8n/logs/n8n.log

# ── Execution ─────────────────────────────────────────────────
EXECUTIONS_PROCESS=main
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200
# Keep execution data for 30 days
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=720

# ── Queue Mode (Redis — for scaling) ─────────────────────────
# N8N_QUEUE_BULL_REDIS_HOST=redis
# N8N_QUEUE_BULL_REDIS_PORT=6379
# N8N_QUEUE_BULL_REDIS_PASSWORD=

# ── Custom Nodes ──────────────────────────────────────────────
# N8N_CUSTOM_EXTENSIONS=/home/node/.n8n/custom
