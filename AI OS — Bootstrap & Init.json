        "jsCode": "return [{ json: {\n  status: 'ok',\n  message: 'AI OS bootstrap complete (idempotent — safe to re-run).',\n  database: {\n    initialized: true,\n    tables: ['ai_os_memory','ai_os_knowledge','ai_os_tasks','ai_os_contacts','ai_os_logs','ai_os_config','ai_os_executions']\n  },\n  drive: {\n    rootFolder: 'AI_OS',\n    parentId: $('Get Parent Folder ID').first().json.parentId,\n    subfolders: ['Projects','Documents','Images','Logs','Backups']\n  }\n} }];"
