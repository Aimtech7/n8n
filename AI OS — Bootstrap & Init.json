      "parameters": {
        "jsCode": "let parentId = null;\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const cand = j.parentId || j.id || null;\n  if (cand) { parentId = cand; break; }\n}\nreturn [{ json: { parentId } }];"
      },
