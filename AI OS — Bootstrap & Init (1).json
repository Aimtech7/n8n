    {
      "parameters": {
        "jsCode": "const found = $input.all().filter(i => i.json && i.json.id && i.json.name === 'AI_OS');\nif (found.length > 0) {\n  return [{ json: { found: true, rootId: found[0].json.id } }];\n}\nreturn [{ json: { found: false, rootId: '' } }];"
      },
