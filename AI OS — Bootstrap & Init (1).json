    {
      "parameters": {
        "jsCode": "const parentId = $('Get Parent Folder ID').first().json.parentId;\nconst desired = ['Projects', 'Documents', 'Images', 'Logs', 'Backups'];\nconst existing = $input.all().map(i => i.json && i.json.name).filter(Boolean);\nconst missing = desired.filter(n => !existing.includes(n));\nreturn missing.map(name => ({ json: { name, parentId } }));"
      },
