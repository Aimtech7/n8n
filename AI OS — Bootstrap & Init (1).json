    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n-- Memory (long-term memory store)\nCREATE TABLE IF NOT EXISTS ai_os_memory (\n  id BIGSERIAL PRIMARY KEY,\n  timestamp TIMESTAMPTZ NOT NULL DEFAULT now(),\n  category TEXT,\n  title TEXT,\n  content TEXT,\n  tags TEXT,\n  source TEXT,\n  importance NUMERIC,\n  embedding_placeholder TEXT\n);\n\n-- Knowledge base\nCREATE TABLE IF NOT EXISTS ai_os_knowledge (\n  id BIGSERIAL PRIMARY KEY,\n  topic TEXT,\n  question TEXT,\n  answer TEXT,\n  source TEXT,\n  updated TIMESTAMPTZ NOT NULL DEFAULT now(),\n  confidence NUMERIC\n);\n\n-- Tasks\nCREATE TABLE IF NOT EXISTS ai_os_tasks (\n  task_id TEXT PRIMARY KEY,\n  title TEXT,\n  description TEXT,\n  priority TEXT,\n  status TEXT DEFAULT 'open',\n  owner TEXT,\n  deadline TIMESTAMPTZ,\n  created TIMESTAMPTZ NOT NULL DEFAULT now(),\n  completed TIMESTAMPTZ\n);\n\n-- Contacts\nCREATE TABLE IF NOT EXISTS ai_os_contacts (\n  id BIGSERIAL PRIMARY KEY,\n  name TEXT,\n  company TEXT,\n  phone TEXT,\n  email TEXT,\n  telegram TEXT,\n  whatsapp TEXT,\n  notes TEXT\n);\n\n-- Logs\nCREATE TABLE IF NOT EXISTS ai_os_logs (\n  id BIGSERIAL PRIMARY KEY,\n  timestamp TIMESTAMPTZ NOT NULL DEFAULT now(),\n  workflow TEXT,\n  module TEXT,\n  action TEXT,\n  status TEXT,\n  execution_time NUMERIC,\n  error TEXT\n);\n\n-- Config (env-like key/value store)\nCREATE TABLE IF NOT EXISTS ai_os_config (\n  key TEXT PRIMARY KEY,\n  value TEXT,\n  updated TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\n-- Execution history\nCREATE TABLE IF NOT EXISTS ai_os_executions (\n  id TEXT PRIMARY KEY,\n  workflow TEXT,\n  status TEXT,\n  started TIMESTAMPTZ,\n  finished TIMESTAMPTZ,\n  error TEXT\n);\n\n-- Seed default config (idempotent)\nINSERT INTO ai_os_config (key, value) VALUES\n  ('default_notification_channel', 'telegram'),\n  ('timezone', 'Africa/Nairobi'),\n  ('ai_model', 'gpt-4o-mini')\nON CONFLICT (key) DO NOTHING;\n",
        "options": {
          "queryBatching": "single"
        }
      },
      "id": "ff10f56a-cf4a-40f9-86ac-932ccf1f2752",
      "name": "Init DB Schema",
